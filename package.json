  "private": true,
  "description": "Site web Fluance Pro - Accompagnement pour entrepreneurs et indépendants",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^7.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.0",
    "npm-run-all2": "^9.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "html-minifier-next": "^9.1.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "ws": "8.22.2"
  }
