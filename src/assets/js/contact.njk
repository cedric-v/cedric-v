---
permalink: /assets/js/contact.js
eleventyExcludeFromCollections: true
---
(function () {
  'use strict';

  var form = document.querySelector('[data-contact-form]');
  var endpoint = '/api/contact';
  var turnstileSiteKey = {{ (env.TURNSTILE_SITE_KEY or '') | dump | safe }};
  var turnstilePromise;

  if (!form) return;
  form.dataset.startedAt = String(Date.now());

  var nameField = form.elements.name;
  var emailField = form.elements.email;
  var messageField = form.elements.message;
  var phoneField = form.elements.phone;

  function isValidEmail(val) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
  }

  // Téléphone : chiffres, espaces, +, (), . et - uniquement (ex. +41 79 123 45 67).
  function isValidPhone(val) {
    return /^\+?[0-9][0-9\s().\-]{4,28}$/.test(val);
  }

  function errorNode(field) {
    return field ? form.querySelector('[data-error-for="' + field.name + '"]') : null;
  }

  function setFieldError(field, message) {
    if (!field) return;
    field.setAttribute('aria-invalid', 'true');
    var node = errorNode(field);
    if (node) {
      node.textContent = message;
      node.hidden = false;
    }
  }

  function clearFieldError(field) {
    if (!field) return true;
    field.removeAttribute('aria-invalid');
    var node = errorNode(field);
    if (node) {
      node.textContent = '';
      node.hidden = true;
    }
    return true;
  }

  // Valide un champ et affiche/masque son message d'erreur inline.
  // opts.submitting : à la soumission on valide aussi les champs vides obligatoires.
  function validateField(field, opts) {
    if (!field) return true;
    var locale = document.documentElement.lang === 'en' ? 'en' : 'fr';
    var value = (field.value || '').trim();
    var submitting = opts && opts.submitting;

    var message = '';
    if (field === nameField && (!value && submitting)) {
      message = locale === 'en' ? 'Please enter your first and last name.' : 'Veuillez indiquer votre prénom et nom.';
    } else if (field === emailField) {
      if (!value) {
        message = locale === 'en' ? 'Please enter your email address.' : 'Veuillez saisir votre adresse e-mail.';
      } else if (!isValidEmail(value)) {
        message = locale === 'en' ? 'This email address seems invalid (e.g. name@example.com).' : 'Cette adresse e-mail semble invalide (ex. nom@exemple.com).';
      }
    } else if (field === phoneField && value && !isValidPhone(value)) {
      message = locale === 'en' ? 'This phone number seems invalid (e.g. +41 79 123 45 67).' : 'Ce numéro semble invalide (ex. +41 79 123 45 67).';
    } else if (field === messageField && (!value && submitting)) {
      message = locale === 'en' ? 'Please write your message.' : 'Veuillez écrire votre message.';
    }

    if (message) {
      setFieldError(field, message);
      return false;
    }
    return clearFieldError(field);
  }

  // Validation en ligne : contrôle au changement de champ (blur), effacement dès la correction.
  [nameField, emailField, phoneField, messageField].forEach(function (field) {
    if (!field) return;
    field.addEventListener('blur', function () {
      // On ne sanctionne pas les champs obligatoires encore vides avant la soumission,
      // mais toute valeur saisie est contrôlée immédiatement.
      if ((field.value || '').trim().length > 0) {
        validateField(field, { submitting: false });
      } else {
        clearFieldError(field);
      }
    });
    field.addEventListener('input', function () {
      if (field.getAttribute('aria-invalid') === 'true') {
        validateField(field, { submitting: false });
      }
    });
  });

  function loadTurnstile() {
    if (!turnstileSiteKey) return Promise.resolve(null);
    if (window.turnstile) return Promise.resolve(window.turnstile);
    if (turnstilePromise) return turnstilePromise;
    turnstilePromise = new Promise(function (resolve) {
      var script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.defer = true;
      script.onload = function () {
        var attempts = 0;
        var wait = setInterval(function () {
          attempts += 1;
          if (window.turnstile) {
            clearInterval(wait);
            resolve(window.turnstile);
          } else if (attempts > 50) {
            clearInterval(wait);
            resolve(null);
          }
        }, 100);
      };
      script.onerror = function () { resolve(null); };
      document.head.appendChild(script);
    });
    return turnstilePromise;
  }

  function initTurnstile() {
    if (!turnstileSiteKey) return;
    var container = form.querySelector('[data-contact-turnstile]');
    if (!container) return;
    loadTurnstile().then(function (turnstile) {
      if (!turnstile || container.dataset.rendered) return;
      try {
        container.dataset.rendered = 'true';
        form._turnstileToken = '';
        form._turnstileWidget = turnstile.render(container, {
          sitekey: turnstileSiteKey,
          theme: 'light',
          size: 'flexible',
          action: 'contact-form',
          callback: function (token) { form._turnstileToken = token; },
          'expired-callback': function () { form._turnstileToken = ''; },
          'error-callback': function () { form._turnstileToken = ''; }
        });
      } catch (error) {
        container.dataset.rendered = '';
      }
    });
  }

  function showMessage(message, type) {
    var node = form.querySelector('[data-contact-message]');
    if (!node) return;
    node.textContent = message;
    node.className = 'contact-form-message ' + (type === 'success' ? 'is-success' : 'is-error');
    node.hidden = false;
  }

  function setLoading(loading) {
    var button = form.querySelector('button[type="submit"]');
    var label = form.querySelector('[data-contact-submit-label]');
    var progress = form.querySelector('[data-contact-submit-loading]');
    if (button) button.disabled = loading;
    if (label) label.hidden = loading;
    if (progress) progress.hidden = !loading;
  }

  function genericError() {
    return document.documentElement.lang === 'en'
      ? 'Your message could not be sent. Please try again later.'
      : 'Votre message n’a pas pu être envoyé. Veuillez réessayer plus tard.';
  }

  initTurnstile();
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    var locale = document.documentElement.lang === 'en' ? 'en' : 'fr';
    var name = (nameField ? nameField.value : '').trim();
    var email = (emailField ? emailField.value : '').trim();
    var message = (messageField ? messageField.value : '').trim();
    var company = form.elements.company ? form.elements.company.value.trim() : '';
    var phone = form.elements.phone ? form.elements.phone.value.trim() : '';
    var topic = form.elements.topic ? form.elements.topic.value : '';
    var website = form.elements.website ? form.elements.website.value.trim() : '';

    var fieldsValid = [nameField, emailField, phoneField, messageField]
      .map(function (field) { return validateField(field, { submitting: true }); })
      .every(Boolean);

    if (!fieldsValid) {
      var firstInvalid = [nameField, emailField, phoneField, messageField]
        .filter(function (field) { return field && field.getAttribute('aria-invalid') === 'true'; })[0];
      if (firstInvalid && typeof firstInvalid.focus === 'function') {
        firstInvalid.focus();
      }
      showMessage(locale === 'en'
        ? 'Please correct the highlighted fields before sending.'
        : 'Veuillez corriger les champs signalés avant l’envoi.', 'error');
      return;
    }

    setLoading(true);
    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        name: name,
        email: email,
        company: company,
        phone: phone,
        topic: topic,
        message: message,
        website: website,
        locale: locale,
        started_at: Number(form.dataset.startedAt || Date.now()),
        turnstile_token: form._turnstileToken || ''
      })
    }).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (data) {
        if (!response.ok || !data.success) throw new Error(data.error || 'request_failed');
        return data;
      });
    }).then(function () {
      form.reset();
      [nameField, emailField, phoneField, messageField].forEach(function (field) {
        if (field) field.removeAttribute('aria-invalid');
      });
      [nameField, emailField, phoneField, messageField].forEach(clearFieldError);
      form.dataset.startedAt = String(Date.now());
      setLoading(false);
      showMessage(locale === 'en'
        ? 'Thank you. Your message has been sent; I will reply personally.'
        : 'Merci. Votre message a bien été envoyé ; je vous répondrai personnellement.', 'success');
      if (window.turnstile && form._turnstileWidget !== undefined) {
        try { window.turnstile.reset(form._turnstileWidget); } catch (error) { /* no-op */ }
      }
    }).catch(function (error) {
      console.error('[contact]', error);
      setLoading(false);
      showMessage(error.message === 'configuration_missing'
        ? (locale === 'en' ? 'The contact form is not configured yet.' : 'Le formulaire de contact n’est pas encore configuré.')
        : genericError(), 'error');
    });
  });
})();
