{% set formId = newsletterFormId or 'newsletter-form' %}
{% set source = newsletterFormSource or 'newsletter_site' %}
<form id="{{ formId }}" class="newsletter-form" data-newsletter-form data-source="{{ source }}" novalidate>
  <div class="newsletter-form-fields">
    <div class="newsletter-field">
      <label for="{{ formId }}-firstname">{{ "newsletter.firstName" | t }} <span aria-hidden="true">({{ "newsletter.optional" | t }})</span></label>
      <input id="{{ formId }}-firstname" name="firstname" type="text" autocomplete="given-name" maxlength="80">
    </div>

    <div class="newsletter-field">
      <label for="{{ formId }}-email">{{ "newsletter.email" | t }} <span aria-hidden="true">*</span></label>
      <input id="{{ formId }}-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" maxlength="254" required aria-describedby="{{ formId }}-email-error">
      {# Erreur inline liée au champ (exigence WCAG 3.3.1 & 3.3.3) : les lecteurs d’écran l’annoncent via aria-describedby. #}
      <p class="newsletter-field-error" id="{{ formId }}-email-error" data-email-error hidden></p>
    </div>
  </div>

  {# Honeypot : ne pas retirer, il filtre les robots sans ajouter de friction. #}
  <div class="newsletter-honeypot" aria-hidden="true">
    <label for="{{ formId }}-website">{{ "newsletter.website" | t }}</label>
    <input id="{{ formId }}-website" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div class="newsletter-turnstile" data-turnstile-container></div>
  <p class="newsletter-turnstile-help" data-turnstile-help hidden></p>

  <button type="submit" class="btn-primary newsletter-submit">
    <span data-submit-label>{{ "newsletter.submit" | t }}</span>
    <span data-submit-loading hidden>{{ "newsletter.sending" | t }}</span>
  </button>

  <p class="newsletter-form-message" data-form-message role="status" aria-live="polite" hidden></p>
  <p class="newsletter-legal">
    {{ "newsletter.privacyIntro" | t }}
    <a href="{{ '/mentions-legales/' | relativeUrl }}" target="_blank" rel="noopener">{{ "newsletter.privacyLink" | t }}</a>.
  </p>
</form>
