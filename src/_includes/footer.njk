<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-content">
        <div class="footer-nav-section">
          <h3 class="footer-nav-title">{{ "footer.navTitle" | t }}</h3>
          <ul class="footer-nav-list">
            {%- for item in nav.footer %}
            {%- if item.type == "link" %}
            <li class="footer-nav-item"><a href="{{ item.url | navUrl(lang) | relativeUrl }}" class="footer-nav-link">{{ item.label | t }}</a></li>
            {%- elif item.type == "group" %}
            <li class="footer-nav-subsection">
              <span class="footer-nav-subsection-title">{{ item.label | t }}</span>
              <ul class="footer-nav-list">
                {%- for link in item.links %}
                <li class="footer-nav-item"><a href="{{ link.url | navUrl(lang) | relativeUrl }}" class="footer-nav-link">{{ link.label | t }}</a></li>
                {%- endfor %}
              </ul>
            </li>
            {%- elif item.type == "separator" %}
            <li class="footer-nav-separator">
              <a href="{{ item.url | navUrl(lang) | relativeUrl }}" class="footer-nav-link">{{ item.label | t }}</a>
            </li>
            {%- elif item.type == "language" %}
            <li class="footer-nav-separator">
              {% if hasTranslation != false %}
              <div class="footer-language-selector">
                {% if lang == 'fr' %}
                <span class="footer-language-current">Français</span>
                <span class="footer-language-separator">|</span>
                <a href="{{ enUrl | relativeUrl }}" class="footer-language-link">English</a>
                {% else %}
                <span class="footer-language-current">English</span>
                <span class="footer-language-separator">|</span>
                <a href="{{ frUrl | relativeUrl }}" class="footer-language-link">Français</a>
                {% endif %}
              </div>
              {% endif %}
            </li>
            {%- endif %}
            {%- endfor %}
          </ul>
        </div>

        <div class="footer-legal-section">
          <h3 class="footer-legal-title">{{ "footer.legalTitle" | t }}</h3>
          <ul class="footer-legal-list">
            <li><a href="{{ '/mentions-legales/' | relativeUrl }}" class="footer-legal-link">{{ "footer.legalNotice" | t }}</a></li>
            <li><a href="{{ '/cgv/' | relativeUrl }}" class="footer-legal-link">{{ "footer.terms" | t }}</a></li>
            <li><button type="button" onclick="window.showCookiePreferences && window.showCookiePreferences()" class="footer-legal-link" style="background:none;border:none;padding:0;cursor:pointer;font:inherit;">{{ "footer.manageCookies" | t }}</button></li>
          </ul>
        </div>

        <div class="footer-newsletter-section">
          <h3 class="footer-newsletter-title">{{ "footer.newsletterTitle" | t }}</h3>
          <p class="footer-newsletter-description">{{ "footer.newsletterDescription" | t }}</p>
          {% set newsletterFormId = 'footer-newsletter-form' %}
          {% set newsletterFormSource = 'footer' %}
          {% include "newsletter-form.njk" %}
        </div>
      </div>

      <div class="footer-social-section">
        <h3 class="footer-social-title">{{ "footer.socialTitle" | t }}</h3>
        <div class="h-card" style="display: none;">
          <a class="u-url" href="https://cedricv.com">Cédric Vonlanthen</a>
          <span class="p-name">Cédric Vonlanthen</span>
          <span class="p-org">Instants Zen Sàrl</span>
          <a class="u-email" href="#" id="h-card-email-link"></a>
          <a class="u-url" rel="me" href="https://fluance.io">Fluance</a>
          <a class="u-url" rel="me" href="https://github.com/cedric-v">GitHub</a>
          <a class="u-url" rel="me" href="https://fr.wikipedia.org/wiki/Utilisateur:Cédric">Wikipedia</a>
          <a class="u-url" href="https://www.linkedin.com/in/cedricvonlanthen/">LinkedIn</a>
          <a class="u-url" href="https://www.instagram.com/cedric_vla/">Instagram</a>
          <a class="u-url" href="https://www.facebook.com/cedric.vonlanthen">Facebook</a>
          <a class="u-url" href="https://www.youtube.com/channel/UCQyZ_fwgJACNmhtjmLiGSkw">YouTube</a>
        </div>
        <div class="footer-social-links">
          <a href="https://www.linkedin.com/in/cedricvonlanthen/" target="_blank" rel="noreferrer" aria-label="{{ "footer.social.linkedin" | t }}" title="{{ "footer.social.linkedin" | t }}" class="footer-social-link">
            <img src="{{ '/assets/img/icons/linkedin.png' | relativeUrl }}" alt="LinkedIn" class="footer-social-icon">
          </a>
          <a href="https://www.instagram.com/cedric_vla/" target="_blank" rel="noreferrer" aria-label="{{ "footer.social.instagram" | t }}" title="{{ "footer.social.instagram" | t }}" class="footer-social-link">
            <img src="{{ '/assets/img/icons/instagram.png' | relativeUrl }}" alt="Instagram" class="footer-social-icon">
          </a>
          <a href="https://www.facebook.com/cedric.vonlanthen" target="_blank" rel="noreferrer" aria-label="{{ "footer.social.facebook" | t }}" title="{{ "footer.social.facebook" | t }}" class="footer-social-link">
            <img src="{{ '/assets/img/icons/facebook.png' | relativeUrl }}" alt="Facebook" class="footer-social-icon">
          </a>
          <a href="https://www.youtube.com/channel/UCQyZ_fwgJACNmhtjmLiGSkw" target="_blank" rel="noreferrer" aria-label="{{ "footer.social.youtube" | t }}" title="{{ "footer.social.youtube" | t }}" class="footer-social-link">
            <img src="{{ '/assets/img/icons/youtube.png' | relativeUrl }}" alt="YouTube" class="footer-social-icon">
          </a>
        </div>
        <p class="footer-contact-info">
          {{ "footer.company" | t }}<br>
          {{ "footer.emailLabel" | t }} <a href="#" id="support-email-link" class="footer-contact-link"></a>
        </p>
        <script>
          // Protection anti-spam : construction dynamique de l'email
          (function() {
            const emailParts = ['support', 'fluance', 'io'];
            const email = emailParts[0] + '@' + emailParts[1] + '.' + emailParts[2];
            const emailLink = document.getElementById('support-email-link');
            if (emailLink) {
              emailLink.href = 'mailto:' + email;
              emailLink.textContent = email;
            }
            // Mettre à jour aussi le lien dans la h-card (sans rel="me" pour éviter les scrapers)
            const hCardEmailLink = document.getElementById('h-card-email-link');
            if (hCardEmailLink) {
              hCardEmailLink.href = 'mailto:' + email;
              hCardEmailLink.textContent = email;
            }
          })();
        </script>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">&copy; {{ "now" | date('yyyy') }} Fluance. {{ "footer.rights" | t }}</p>
    </div>
  </div>
</footer>
