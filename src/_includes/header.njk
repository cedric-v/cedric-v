<header id="main-header" class="site-header">
  <div class="header-container">
    <a href="{{ '/' | navUrl(lang) | relativeUrl }}" class="header-logo">
      {% image "assets/img/new-logo-cedriv.png", "Fluance Pro", "", "eager", "", "400", "200", "(max-width: 768px) 94px, 400px" %}
      <span class="header-slogan">{{ "header.slogan" | t }}</span>
    </a>

    <button class="mobile-menu-toggle" data-menu-toggle aria-label="Open menu">
      <svg class="mobile-menu-icon" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <nav class="header-navigation" data-menu>
      {%- for group in nav.header.groups %}
      <!-- {{ group.label }} dropdown -->
      <div class="nav-dropdown">
        <button class="nav-dropdown-toggle">
          {{ group.label | t }}
          <svg class="dropdown-arrow-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="nav-dropdown-menu{% if group.large %} large{% endif %}">
          <div class="dropdown-content">
            {%- for item in group.links %}
            <a href="{{ item.url | navUrl(lang) | relativeUrl }}" class="dropdown-link">{{ item.label | t }}</a>
            {%- endfor %}
          </div>
        </div>
      </div>
      {%- endfor %}

      {%- for item in nav.header.links %}
      <a href="{{ item.url | navUrl(lang) | relativeUrl }}" class="nav-link{% if item.cta %} nav-cta{% endif %}">{{ item.label | t }}</a>
      {%- endfor %}

      {% if hasTranslation != false %}
      <div class="language-selector">
        {% if lang == 'fr' %}
          <span class="language-current">FR</span>
          <a href="{{ enUrl | relativeUrl }}" class="language-link">EN</a>
        {% else %}
          <a href="{{ frUrl | relativeUrl }}" class="language-link">FR</a>
          <span class="language-current">EN</span>
        {% endif %}
      </div>
      {% endif %}
        </nav>
  </div>

  <!-- Mobile menu -->
  <nav class="mobile-navigation" data-menu-mobile>
    {%- for group in nav.header.groups %}
    <div class="mobile-nav-section">
      <button class="mobile-dropdown-toggle" data-mobile-dropdown="{{ group.id }}">
        {{ group.label | t }}
        <svg class="mobile-dropdown-arrow" data-arrow="{{ group.id }}" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
      <div class="mobile-dropdown-content" data-dropdown-content="{{ group.id }}">
        {%- for item in group.links %}
        <a href="{{ item.url | navUrl(lang) | relativeUrl }}" class="mobile-nav-link">{{ item.label | t }}</a>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}

    {%- for item in nav.header.links %}
    <a href="{{ item.url | navUrl(lang) | relativeUrl }}" class="mobile-nav-link{% if item.cta %} nav-cta{% endif %}">{{ item.label | t }}</a>
    {%- endfor %}

    {% if hasTranslation != false %}
    <div class="mobile-language-selector">
      {% if lang == 'fr' %}
        <span class="language-current">FR</span>
        <span class="mobile-language-separator">|</span>
        <a href="{{ enUrl | relativeUrl }}" class="language-link">EN</a>
      {% else %}
        <a href="{{ frUrl | relativeUrl }}" class="language-link">FR</a>
        <span class="mobile-language-separator">|</span>
        <span class="language-current">EN</span>
      {% endif %}
    </div>
    {% endif %}
  </nav>
</header>
