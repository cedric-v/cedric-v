{% set formId = contactFormId or 'contact-form' %}
<form id="{{ formId }}" class="contact-form" data-contact-form novalidate>
  <div class="contact-form-grid">
    <div class="contact-field">
      <label for="{{ formId }}-name">{% if locale == 'fr' %}Prénom et nom{% else %}First name and last name{% endif %} <span aria-hidden="true">*</span></label>
      <input id="{{ formId }}-name" name="name" type="text" autocomplete="name" maxlength="120" required>
    </div>
    <div class="contact-field">
      <label for="{{ formId }}-email">{% if locale == 'fr' %}Adresse e-mail{% else %}Email address{% endif %} <span aria-hidden="true">*</span></label>
      <input id="{{ formId }}-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required>
    </div>
  </div>

  <div class="contact-form-grid">
    <div class="contact-field">
      <label for="{{ formId }}-company">{% if locale == 'fr' %}Activité ou entreprise{% else %}Business or company{% endif %} <span>{% if locale == 'fr' %}(facultatif){% else %}(optional){% endif %}</span></label>
      <input id="{{ formId }}-company" name="company" type="text" autocomplete="organization" maxlength="120">
    </div>
    <div class="contact-field">
      <label for="{{ formId }}-topic">{% if locale == 'fr' %}Votre besoin{% else %}Your situation{% endif %}</label>
      <select id="{{ formId }}-topic" name="topic">
        {% if locale == 'fr' %}
        <option value="independant">Je suis indépendant·e / entrepreneur·e</option>
        <option value="pme">Je représente une TPE / PME</option>
        <option value="question">J’ai une question générale</option>
        {% else %}
        <option value="independent">I am an independent / entrepreneur</option>
        <option value="sme">I represent an SME</option>
        <option value="question">I have a general question</option>
        {% endif %}
      </select>
    </div>
  </div>

  <div class="contact-field">
    <label for="{{ formId }}-message">{% if locale == 'fr' %}Votre message{% else %}Your message{% endif %} <span aria-hidden="true">*</span></label>
    <textarea id="{{ formId }}-message" name="message" rows="7" maxlength="5000" required placeholder="{% if locale == 'fr' %}Décrivez simplement votre situation et ce que vous aimeriez clarifier.{% else %}Briefly describe your situation and what you would like to clarify.{% endif %}"></textarea>
  </div>

  {# Honeypot : invisible pour les personnes, utile contre les robots. #}
  <div class="contact-honeypot" aria-hidden="true">
    <label for="{{ formId }}-website">{% if locale == 'fr' %}Site web{% else %}Website{% endif %}</label>
    <input id="{{ formId }}-website" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div class="contact-turnstile" data-contact-turnstile></div>
  <p class="contact-form-message" data-contact-message role="status" aria-live="polite" hidden></p>

  <button type="submit" class="btn-primary contact-submit">
    <span data-contact-submit-label>{% if locale == 'fr' %}Envoyer mon message{% else %}Send my message{% endif %}</span>
    <span data-contact-submit-loading hidden>{% if locale == 'fr' %}Envoi en cours…{% else %}Sending…{% endif %}</span>
  </button>

  <p class="contact-legal">
    {% if locale == 'fr' %}
    Vos informations servent uniquement à répondre à votre demande. Consultez les
    {% else %}
    Your information is used only to respond to your request. See our
    {% endif %}
    <a href="{{ '/mentions-legales/' | relativeUrl }}" target="_blank" rel="noopener">{% if locale == 'fr' %}mentions légales et politique de confidentialité{% else %}legal notice and privacy policy{% endif %}</a>.
  </p>
</form>
