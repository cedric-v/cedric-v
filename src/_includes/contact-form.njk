{% set formId = contactFormId or 'contact-form' %}
<form id="{{ formId }}" class="contact-form" data-contact-form novalidate>
  <div class="contact-form-grid">
    <div class="contact-field">
      <label for="{{ formId }}-name">{{ "contact.name" | t }} <span aria-hidden="true">*</span></label>
      <input id="{{ formId }}-name" name="name" type="text" autocomplete="name" maxlength="120" required aria-describedby="{{ formId }}-name-error">
      <p class="contact-field-error" id="{{ formId }}-name-error" data-error-for="name" hidden></p>
    </div>
    <div class="contact-field">
      <label for="{{ formId }}-email">{{ "contact.email" | t }} <span aria-hidden="true">*</span></label>
      <input id="{{ formId }}-email" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" maxlength="254" required aria-describedby="{{ formId }}-email-error">
      <p class="contact-field-error" id="{{ formId }}-email-error" data-error-for="email" hidden></p>
    </div>
  </div>

  <div class="contact-form-grid">
    <div class="contact-field">
      <label for="{{ formId }}-company">{{ "contact.company" | t }} <span>{{ "contact.optional" | t }}</span></label>
      <input id="{{ formId }}-company" name="company" type="text" autocomplete="organization" maxlength="120">
    </div>
    <div class="contact-field">
      <label for="{{ formId }}-phone">{{ "contact.phone" | t }} <span>{{ "contact.optional" | t }}</span></label>
      <input id="{{ formId }}-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" aria-describedby="{{ formId }}-phone-error">
      <p class="contact-field-error" id="{{ formId }}-phone-error" data-error-for="phone" hidden></p>
    </div>
  </div>

  <div class="contact-form-grid">
    <div class="contact-field">
      <label for="{{ formId }}-topic">{{ "contact.need" | t }}</label>
      <select id="{{ formId }}-topic" name="topic">
        {% if locale == 'fr' %}
        <option value="independant">Je suis indépendant·e / entrepreneur·e</option>
        <option value="pme">Je représente une TPE / PME</option>
        <option value="question">J’ai une question générale</option>
        {% else %}
        <option value="independent">I am an independent / entrepreneur</option>
        <option value="sme">I represent an SME</option>
        <option value="question">I have a general question</option>
        {% endif %}
      </select>
    </div>
  </div>

  <div class="contact-field">
    <label for="{{ formId }}-message">{{ "contact.message" | t }} <span aria-hidden="true">*</span></label>
    <textarea id="{{ formId }}-message" name="message" rows="7" maxlength="5000" required placeholder="{{ "contact.messagePlaceholder" | t }}" aria-describedby="{{ formId }}-message-error"></textarea>
    <p class="contact-field-error" id="{{ formId }}-message-error" data-error-for="message" hidden></p>
  </div>

  {# Honeypot : invisible pour les personnes, utile contre les robots. #}
  <div class="contact-honeypot" aria-hidden="true">
    <label for="{{ formId }}-website">{{ "contact.website" | t }}</label>
    <input id="{{ formId }}-website" name="website" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div class="contact-turnstile" data-contact-turnstile></div>
  <p class="contact-form-message" data-contact-message role="status" aria-live="polite" hidden></p>

  <button type="submit" class="btn-primary contact-submit">
    <span data-contact-submit-label>{{ "contact.submit" | t }}</span>
    <span data-contact-submit-loading hidden>{{ "contact.sending" | t }}</span>
  </button>

  <p class="contact-legal">
    {{ "contact.privacyIntro" | t }}
    <a href="{{ '/mentions-legales/' | relativeUrl }}" target="_blank" rel="noopener">{{ "contact.privacyLink" | t }}</a>.
  </p>
</form>
