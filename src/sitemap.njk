---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for page in collections.all -%}
  {%- if page.url -%}
    {%- if page.url != "/sitemap.xml" -%}
      {%- if page.url != "/404.html" -%}
        {%- set hasJson = false -%}
        {%- if ".json" in page.url -%}
          {%- set hasJson = true -%}
        {%- endif -%}
        {%- set hasXml = false -%}
        {%- if ".xml" in page.url -%}
          {%- set hasXml = true -%}
        {%- endif -%}
        {%- set hasReadme = false -%}
        {%- if "/README" in page.url or "/readme" in page.url -%}
          {%- set hasReadme = true -%}
        {%- endif -%}
        {%- set hasJs = false -%}
        {%- if ".js" in page.url -%}
          {%- set hasJs = true -%}
        {%- endif -%}
        {%- set cleanUrl = page.url | replace("/fluance-io", "") -%}
        {%- set isRedirect = false -%}
        {%- if cleanUrl == "/" -%}
          {%- set isRedirect = true -%}
        {%- endif -%}
        {%- set isNoindex = false -%}
        {%- if page.data.noindex or page.data.redirectTo -%}
          {%- set isNoindex = true -%}
        {%- endif -%}
        {%- set isExcludedFromCollections = false -%}
        {%- if page.data.eleventyExcludeFromCollections -%}
          {%- set isExcludedFromCollections = true -%}
        {%- endif -%}
        
        {%- if not hasJson and not hasXml and not hasReadme and not hasJs and not isRedirect and not isNoindex and not isExcludedFromCollections and not page.url.startsWith("/.well-known/") and page.url != "/COPYRIGHT" -%}
          {%- set fullUrl = "https://cedricv.com" + cleanUrl -%}
          {%- if page.date -%}
            {%- set lastmod = page.date | date("YYYY-MM-DD") -%}
          {%- else -%}
            {%- set lastmod = "now" | date("YYYY-MM-DD") -%}
          {%- endif -%}
          {%- set changefreq = "monthly" -%}
          {%- if cleanUrl == "/" -%}
            {%- set changefreq = "weekly" -%}
          {%- endif -%}
          {%- if cleanUrl == "/fr/" -%}
            {%- set changefreq = "weekly" -%}
          {%- endif -%}
          {%- if cleanUrl == "/en/" -%}
            {%- set changefreq = "weekly" -%}
          {%- endif -%}
          {%- set priority = "0.6" -%}
          {%- if cleanUrl == "/" -%}
            {%- set priority = "1.0" -%}
          {%- endif -%}
          {%- if cleanUrl == "/fr/" -%}
            {%- set priority = "1.0" -%}
          {%- endif -%}
          {%- if cleanUrl == "/en/" -%}
            {%- set priority = "1.0" -%}
          {%- endif -%}
          {%- if "/a-propos/" in cleanUrl -%}
            {%- set priority = "0.8" -%}
          {%- endif -%}
  <url>
    <loc>{{ fullUrl }}</loc>
    <lastmod>{{ lastmod }}</lastmod>
    <changefreq>{{ changefreq }}</changefreq>
    <priority>{{ priority }}</priority>
    {%- if page.data.hasTranslation != false -%}
      {# Réutiliser exactement l'appariement de l'I18nPlugin utilisé dans base.njk. #}
      {%- set otherLinks = page.url | locale_links -%}
      {%- set otherFr = otherLinks | selectattr("lang", "equalto", "fr") | first -%}
      {%- set otherEn = otherLinks | selectattr("lang", "equalto", "en") | first -%}
      {%- if page.data.locale == "fr" -%}
        {%- set frUrl = cleanUrl -%}
        {%- set enUrl = page.data.translation or (otherEn.url if otherEn else "") -%}
      {%- else -%}
        {%- set enUrl = cleanUrl -%}
        {%- set frUrl = page.data.translation or (otherFr.url if otherFr else "") -%}
      {%- endif -%}
      {%- if frUrl and enUrl -%}
    <xhtml:link rel="alternate" hreflang="fr" href="https://cedricv.com{{ frUrl }}" />
    <xhtml:link rel="alternate" hreflang="en" href="https://cedricv.com{{ enUrl }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://cedricv.com{{ frUrl }}" />
      {%- endif -%}
    {%- endif -%}
  </url>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
</urlset>
